  "scriptProvenance": "Original fictional sample authored for the studio demonstration, not supplied by the user.",
  "scenes": [
    {
      "action": "discover",
      "title": "The last light",
      "narration": "One light capsule. One damaged bridge. And a whole valley waiting for sunrise. Pip found the capsule cooling in an empty workshop. If it went dark, every route home would disappear.",
      "at": 0,
      "duration": 13.459999999999999
    },
    {
      "action": "approach",
      "title": "A bridge in the dark",
      "narration": "He clipped it into his teal satchel and ran. The bridge looked safe. Then a plank rolled under his foot. Pip stopped inches from the gap. Confidence had almost become a very expensive mistake.",
      "at": 13.459999999999999,
      "duration": 13.7
    },
    {
      "action": "fail",
      "title": "The warning",
      "narration": "Ada arrived as Pip backed away. He wanted a shortcut. She wanted an answer. What, exactly, had failed? They looked past the painted rails and found the missing connection in the middle.",
      "at": 27.159999999999997,
      "duration": 13.649999999999999
    },
    {
      "action": "inspect",
      "title": "Look before you leap",
      "narration": "Pip traced the route: entrance, span, exit. Two parts were sound. One was not. Suddenly the problem was smaller than his fear. They did not need a new bridge. They needed the right repair.",
      "at": 40.809999999999995,
      "duration": 14.83
    },
    {
      "action": "build",
      "title": "One piece at a time",
      "narration": "They brought three beams from the workshop. Ada fixed the anchors. Pip placed the beams, one after another. The path was connected again. But looking repaired was still different from being ready.",
      "at": 55.63999999999999,
      "duration": 13.549999999999999
    },
    {
      "action": "test",
      "title": "A small test first",
      "narration": "First came a small test weight. Then a heavier one. The repaired span held both. Pip watched the joints instead of the finish line, and finally stepped onto a path he could explain.",
      "at": 69.19,
      "duration": 12.639999999999999
    },
    {
      "action": "cross",
      "title": "Carry the light",
      "narration": "Across the river, the lighthouse waited. Pip raised the capsule. Nothing. One long second. Then amber light reached across the water, and the dark valley began finding its way home.",
      "at": 81.83,
      "duration": 13.79
    },
    {
      "action": "resolve",
      "title": "A path worth trusting",
      "narration": "Pip looked back at Ada. The bridge was still the same bridge. He was the part that had changed. Tomorrow, someone else would need that crossing. This time, the light would stay on.",
      "at": 95.62,
      "duration": 12.91
    }
  ],
  "audience": "13–17; curious adventure, earned problem-solving, no preschool tone",
