    },
    {
      "start": 15.38775,
      "end": 17.222874,
      "text": "وروبوتها يتعطل."
    },
    {
      "start": 18.713207999999998,
      "end": 21.239791,
      "text": "وجدت آلة غريبة في الزقاق."
    },
    {
      "start": 22.173833,
      "end": 24.540875,
      "text": "ساعتها تتحرك إلى الخلف،"
    },
    {
      "start": 24.766916,
      "end": 28.383957999999996,
      "text": "وتذكرة حمراء تعدها بدقيقة إضافية."
    },
    {
      "start": 30.013207999999995,
      "end": 31.795123999999998,
      "text": "دفعت قطعة نقدية."
    },
    {
      "start": 32.715832999999996,
      "end": 34.032333,
      "text": "توقفت الساعة،"
    },
    {
      "start": 34.178625,
      "end": 35.734457,
      "text": "وسحبت التذكرة."
    },
    {
      "start": 36.652041,
      "end": 38.80625,
      "text": "وصلت قبل إغلاق الباب."
    },
    {
      "start": 40.303208,
      "end": 42.86970699999999,
      "text": "لكن سام نظر إليها بغرابة،"
    },
    {
      "start": 43.095749999999995,
      "end": 45.489374,
      "text": "وكأنه يراها للمرة الأولى."
    },
    {
      "start": 47.093208,
      "end": 49.85912499999999,
      "text": "مدت يدها: ثلاث نقرات،"
    },
    {
      "start": 50.018708,
      "end": 51.78733299999999,
      "text": "تحيتهما السرية."
    },
    {
      "start": 52.721374999999995,
      "end": 53.851665999999994,
      "text": "لم يتذكر."
    },
    {
      "start": 54.782540999999995,
      "end": 57.854333,
      "text": "كانت الصورة تحمل مكاناً فارغاً."
    },
    {
      "start": 59.553208,
      "end": 62.37233199999999,
      "text": "على ظهر التذكرة ظهر الثمن: كل"
    },
    {
      "start": 62.385625,
      "end": 65.710124,
      "text": "دقيقة مستعارة تمحو ذكرى مشتركة."
    },
    {
      "start": 67.45320799999999,
      "end": 68.862749,
      "text": "نظرت إلى الكأس،"
    },
    {
      "start": 69.04891599999999,
      "end": 70.29891599999999,
      "text": "ثم إلى سام."
    },
    {
      "start": 71.21966599999999,
      "end": 73.054749,
      "text": "أغلقت صندوق الروبوت،"
    },
    {
      "start": 73.25425,
      "end": 74.623916,
      "text": "وعادت للآلة."
    },
    {
      "start": 76.163208,
      "end": 77.57275,
      "text": "أعادت التذكرة."
    },
    {
      "start": 78.4935,
      "end": 81.49883200000001,
      "text": "تسارعت الساعة وانتهت المسابقة."
    },
    {
      "start": 82.429666,
      "end": 84.823291,
      "text": "لكن وجه سام عاد إلى الصورة."
    },
    {
      "start": 86.663208,
      "end": 88.564791,
      "text": "رفع يده: نقرة،"
    },
    {
      "start": 88.777541,
      "end": 89.695082,
      "text": "نقرتان،"
    },
    {
      "start": 89.907875,
      "end": 90.57275,
      "text": "ثلاث."
    },
    {
      "start": 91.506791,
      "end": 92.610541,
      "text": "ضحكت ميرا."
    },
    {
      "start": 93.541375,
      "end": 94.791416,
      "text": "خسرت الكأس،"
    },
    {
      "start": 94.96425,
      "end": 97.517416,
      "text": "واحتفظت بما يستحق وقتها."
    }
  ],
  "bibleHash": "b1211ffd21849aa4fbf07eef3e6aa78cad5b62e0f8d65059df6c75d44a2d323e",
  "captionsEn": [
    {
      "start": 0.103208,
      "end": 3.2224963076923077,
      "text": "Mira bought a minute from tomorrow."
    },
    {
      "start": 3.2224963076923077,
      "end": 5.3020218461538455,
      "text": "Suddenly, Sam vanished from"
    },
    {
      "start": 5.3020218461538455,
      "end": 6.861666,
      "text": "their old photo."
    },
    {
      "start": 8.403208000000001,
      "end": 10.259979789473686,
      "text": "She was late for"
    },
    {
      "start": 10.259979789473686,
      "end": 11.652558631578948,
      "text": "the robotics competition."
    },
    {
      "start": 11.652558631578948,
      "end": 13.509330421052633,
      "text": "The doors would close"
    },
    {
      "start": 13.509330421052633,
      "end": 14.901909263157895,
      "text": "in one minute."
    },
    {
      "start": 14.901909263157895,
      "end": 17.222874,
      "text": "Her robot was breaking down."
    },
    {
      "start": 18.713207999999998,
      "end": 20.74915536842105,
      "text": "She found a strange"
    },
    {
      "start": 20.74915536842105,
      "end": 22.785102736842102,
      "text": "machine in the alley."
    },
    {
      "start": 22.785102736842106,
      "end": 24.821050105263158,
      "text": "Its clock ran backwards."
    },
    {
      "start": 24.821050105263158,
      "end": 26.85699747368421,
      "text": "A red ticket promised"
    },
    {
      "start": 26.85699747368421,
      "end": 28.383958,
      "text": "an extra minute."
    },
    {
      "start": 30.013207999999995,
      "end": 32.08215905882352,
      "text": "She paid a coin."
    },
    {
      "start": 32.08215905882353,
      "end": 34.15111011764706,
      "text": "The clock stopped. She"
    },
    {
      "start": 34.15111011764706,
      "end": 35.702823411764705,
      "text": "pulled the ticket."
    },
    {
      "start": 35.702823411764705,
      "end": 38.80625,
      "text": "She arrived before the doors closed."
    },
    {
      "start": 40.303208,
      "end": 42.52585057142857,
      "text": "But Sam looked at her strangely,"
    },
    {
      "start": 42.52585057142856,
      "end": 44.00761228571428,
      "text": "as if he had"
    },
    {
      "start": 44.00761228571428,
      "end": 45.48937399999999,
      "text": "never seen her before."
    },
    {
      "start": 47.093208,
      "end": 49.48456911111111,
      "text": "She reached out: three"
    },
    {
      "start": 49.48456911111111,
      "end": 51.87593022222222,
      "text": "taps, their secret greeting."
    },
    {
      "start": 51.875930222222216,
      "end": 54.267291333333326,
      "text": "He did not remember."
    },
    {
      "start": 54.26729133333333,
      "end": 57.854333,
      "text": "The photo held an empty space."
    },
    {
      "start": 59.553208,
      "end": 62.394861538461534,
      "text": "The price appeared on the ticket:"
    },
    {
      "start": 62.394861538461534,
      "end": 64.28929723076922,
      "text": "every borrowed minute erases"
    },
    {
      "start": 64.28929723076922,
      "end": 65.710124,
      "text": "a shared memory."
    },
    {
      "start": 67.45320799999999,
      "end": 68.9628307368421,
      "text": "She looked at the"
    },
    {
      "start": 68.9628307368421,
      "end": 70.4724534736842,
      "text": "trophy, then at Sam."
    },
    {
      "start": 70.4724534736842,
      "end": 72.35948189473683,
      "text": "She closed the robot box"
    },
    {
      "start": 72.35948189473683,
      "end": 74.623916,
      "text": "and went back to the machine."
    },
    {
      "start": 76.163208,
      "end": 78.32822875,
      "text": "She returned the ticket."
    },
    {
      "start": 78.32822875000001,
      "end": 81.575759875,
      "text": "The clock raced; the competition ended."
    },
    {
      "start": 81.575759875,
      "end": 84.823291,
      "text": "But Sam returned to the photo."
    },
    {
      "start": 86.663208,
      "end": 88.8340496,
      "text": "He raised his hand."
    },
    {
      "start": 88.8340496,
      "end": 92.090312,
      "text": "One tap. Two. Three. Mira laughed."
    },
    {
      "start": 92.090312,
      "end": 94.803864,
      "text": "She lost the trophy, but"
    },
    {
      "start": 94.803864,
      "end": 97.517416,
      "text": "kept what deserved her time."
    }
  ],
  "captionLanguages": [
    "en",
